NORTH_BOT_HANDLE=miq
NORTH_SESSION_COOKIE_FILE=data/north-session.cookie
NORTH_MIQ_STATE_FILE=data/north-miq-state.json
NORTH_MIQ_PREVIEW_DIR=data/miq-previews
NORTH_BROWSER_PROFILE_DIR=data/north-browser-profile
NORTH_GATEWAY_HOST=127.0.0.1
NORTH_GATEWAY_PORT=8787
NORTH_GATEWAY_POLL_MS=5000
NORTH_GATEWAY_NOTIFICATION_REFRESH_MS=30000
NORTH_GATEWAY_CACHE_MAX_ENTRIES=512
NORTH_GATEWAY_UPSTREAM_MAX_QUEUE=100
NORTH_GATEWAY_STATE_FILE=data/north-gateway-state.json
NORTH_GATEWAY_ALLOW_WRITES=0

# Optional overrides
# NORTH_ORIGIN=https://north.rip
# NORTH_MIQ_TRIGGER_KINDS=MENTION
# NORTH_GATEWAY_TOKEN=local-only-secret
